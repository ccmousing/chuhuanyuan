{
  "description": "出花园 · 潮汕成人礼小程序（原型 7 屏 1:1 移植）",
  "projectname": "chuhuayuan",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "packOptions": {
    "ignore": [
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "suffix",
        "value": ".md"
      },
      {
        "type": "folder",
        "value": ".git"
      },
      {
        "type": "file",
        "value": "project.private.config.json"
      },
      {
        "type": "folder",
        "value": "node_modules"
      }
    ],
    "include": []
  },
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}
