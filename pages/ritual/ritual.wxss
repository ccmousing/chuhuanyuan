/* 仪式体验样式（原型 .rit-top / .pdot / .rit-card） */

.rit-top {
  padding: 0 36rpx 36rpx;
  color: #F4ECE2;
  background: linear-gradient(160deg, #2B2320, #3D322C);
}
.rit-top .k {
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: rgba(230, 197, 131, 0.85);
  margin-top: 16rpx;
}
.rt-title { font-size: 42rpx; line-height: 1.3; margin: 12rpx 0 24rpx; font-weight: 700; }

.pdot { display: flex; }
.pd {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-right: 10rpx;
}
.pd:last-child { margin-right: 0; }
.pd.f { background: linear-gradient(90deg, #E6C583, #C8443C); }

.rt-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-top: 16rpx;
  opacity: 0.85;
}
.rt-meta .b { font-weight: 700; }

.rit-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 34rpx;
  margin: 28rpx 32rpx;
  border: 2rpx solid rgba(43, 35, 32, 0.09);
  box-shadow: 0 8rpx 36rpx rgba(43, 35, 32, 0.06);
}
.rit-card .no {
  font-size: 80rpx;
  line-height: 1;
  color: rgba(185, 141, 62, 0.32);
  font-weight: 700;
}
.rit-card .rc-title { font-size: 42rpx; line-height: 1.3; margin: 8rpx 0 24rpx; font-weight: 700; color: #2B2320; }
.rit-card .lb { font-size: 22rpx; letter-spacing: 3rpx; color: #A0937F; margin-bottom: 8rpx; }
.rit-card .rc-p { font-size: 26rpx; color: #6B5D52; line-height: 1.75; }
.rit-card .mean {
  background: rgba(200, 68, 60, 0.06);
  border-left: 6rpx solid #C8443C;
  border-radius: 0 18rpx 18rpx 0;
  padding: 18rpx 24rpx;
  font-size: 25rpx;
  color: #C8443C;
  margin-top: 24rpx;
}
.hint { text-align: center; font-size: 23rpx; color: #A0937F; margin-top: 28rpx; }

/* 重新走一遍（弱化处理，避免误触） */
.reset {
  text-align: center;
  font-size: 23rpx;
  color: #A0937F;
  text-decoration: underline;
  margin-top: 22rpx;
  padding: 10rpx 0;
}
