/* 文化问答 · 精致聊天风格 */

.page {
  background: #FDF8F0;
  height: 100vh;
  /* 本页已升为 tabBar 页：自定义 tabBar 是 fixed 定位，需自己让出底部空间 */
  padding-bottom: calc(116rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.msg-list {
  flex: 1;
  padding: 28rpx 28rpx 8rpx;
  box-sizing: border-box;
}

/* —— 消息行 —— */
.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}
.msg.right { justify-content: flex-end; }

/* AI 头像：卡通石榴娃娃（data-URI SVG，矢量图，20px 下不发虚、不占包体） */
.avatar {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Ccircle%20cx='12'%20cy='12'%20r='12'%20fill='%23FFF6EC'/%3E%3Cpath%20d='M12,5.4c-1.5,-2%20-3.9,-1.9%20-4.4,-0.3%201.4,-0.4%203,0.1%204.4,0.3z'%20fill='%236E9B6A'/%3E%3Cpath%20d='M12,5.4c1.5,-2%203.9,-1.9%204.4,-0.3%20-1.4,-0.4%20-3,0.1%20-4.4,0.3z'%20fill='%236E9B6A'/%3E%3Ccircle%20cx='12'%20cy='13.2'%20r='6.2'%20fill='%23C8443C'/%3E%3Ccircle%20cx='9.6'%20cy='10.8'%20r='1.3'%20fill='%23E28176'/%3E%3Ccircle%20cx='9.8'%20cy='12.9'%20r='1'%20fill='%23FFF6EC'/%3E%3Ccircle%20cx='14.2'%20cy='12.9'%20r='1'%20fill='%23FFF6EC'/%3E%3Cpath%20d='M10.4,15.2q1.6,1.2%203.2,0'%20stroke='%23FFF6EC'%20stroke-width='1'%20fill='none'%20stroke-linecap='round'/%3E%3Ccircle%20cx='8.2'%20cy='14.7'%20r='0.9'%20fill='%23E89288'/%3E%3Ccircle%20cx='15.8'%20cy='14.7'%20r='0.9'%20fill='%23E89288'/%3E%3C/svg%3E");
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

.body {
  flex: 0 1 auto;
  max-width: 78%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.msg.right .body { align-items: flex-end; }

/* —— 气泡 —— */
.bubble {
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.85;
  word-break: break-all;
}
.b-ai {
  background: #FFFFFF;
  color: #2B2320;
  border: 1rpx solid #EDE4D6;
  border-radius: 4rpx 24rpx 24rpx 24rpx;
}
.b-user {
  background: #C8443C;
  color: #FFFFFF;
  border-radius: 24rpx 24rpx 4rpx 24rpx;
}

.b-tx {
  white-space: pre-wrap;
  display: block;
}

/* —— 打字态：三点跳动 —— */
.typing {
  display: flex;
  align-items: center;
  height: 40rpx;
  padding: 0 4rpx;
}
.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #C9BCA8;
  margin-right: 10rpx;
  animation: dotPulse 1.2s infinite ease-in-out;
}
.dot:last-child { margin-right: 0; }
.d2 { animation-delay: 0.15s; }
.d3 { animation-delay: 0.3s; }

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-6rpx); }
}

/* —— 来源胶囊 —— */
.sources {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.pill {
  font-size: 22rpx;
  color: #8A7A66;
  background: #F5EEE0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

/* —— 欢迎页建议问题 —— */
.suggests {
  margin: 8rpx 0 24rpx 52rpx;
}
.sug {
  display: inline-block;
  background: #FFFFFF;
  border: 1rpx solid #EDE4D6;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  margin: 0 12rpx 16rpx 0;
  font-size: 25rpx;
  color: #6B5D52;
}

/* —— 底部输入条 —— */
.bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(43, 35, 32, 0.08);
}
.ipt {
  flex: 1;
  background: #F4EEE2;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: #2B2320;
}
.btn {
  margin-left: 16rpx;
  background: #C8443C;
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
.btn-off { opacity: 0.5; }
