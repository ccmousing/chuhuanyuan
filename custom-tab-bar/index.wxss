/* 自定义 TabBar：尺寸与原型 .tabbar 一致（58px → 116rpx） */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: 116rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 2rpx solid rgba(43, 35, 32, 0.09);
}

.tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tb-ic {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 6rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.tb-tx {
  font-size: 21rpx;
  line-height: 1.3;
  color: #A0937F;
}
.tb.on .tb-tx { color: #C8443C; font-weight: 600; }

